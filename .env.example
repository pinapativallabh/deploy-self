# ==========================================
# ForgeDeploy Root Environment Configuration
# ==========================================

# ------------------------------------------
# Backend Settings
# ------------------------------------------
BACKEND_APP_NAME="ForgeDeploy Backend"
BACKEND_APP_ENV=development
BACKEND_LOG_LEVEL=info
BACKEND_PORT=8000

# ------------------------------------------
# Worker Settings
# ------------------------------------------
WORKER_NAME="ForgeDeploy Worker"
WORKER_APP_ENV=development
WORKER_LOG_LEVEL=info

# ------------------------------------------
# Database Settings (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=forgeadmin
POSTGRES_PASSWORD=forgepassword
POSTGRES_DB=forgedeploy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------
# Redis Settings
# ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------
# Docker Settings
# ------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock
