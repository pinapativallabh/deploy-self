# ==========================================
# Bonk Backend — Environment Configuration
# ==========================================
# Copy this file to .env and update the values for your environment.
# Never commit .env to version control.

# --- Application ---
APP_NAME=Bonk
APP_ENV=development                    # development | staging | production
APP_VERSION=0.1.0
LOG_LEVEL=info                         # debug | info | warning | error

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- PostgreSQL ---
POSTGRES_USER=bonk
POSTGRES_PASSWORD=bonk_dev_password    # Change in production!
POSTGRES_DB=bonk
POSTGRES_HOST=localhost                # Use "postgres" inside Docker Compose
POSTGRES_PORT=5433                     # 5433 to avoid conflict with local PostgreSQL

# --- Redis ---
REDIS_HOST=localhost                   # Use "redis" inside Docker Compose
REDIS_PORT=6379
REDIS_DB=0

# --- JWT / Authentication ---
JWT_SECRET_KEY=bonk-dev-secret-change-in-production   # MUST change in production!
JWT_ALGORITHM=HS256                                    # HS256 is standard for single-service JWTs
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15                     # Short-lived access tokens
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7                        # Long-lived refresh tokens
